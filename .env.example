NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
# Transaction pooler (port 6543) — lib/db.ts sets prepare:false for PgBouncer.
DB_URL=""
NEXT_PUBLIC_SANDBOX_MODE=true
# Canonical origin, used for OG/metadata in app/layout.tsx. Auth redirects use
# window.location.origin instead, so every host you serve from must also be on
# the Supabase Redirect URLs allow-list.
NEXT_PUBLIC_SITE_URL=

# SolidPay — powers "auto" payment mode (JazzCash / Easypaisa collections + payouts)
SOLID_PAY_API_KEY=
SOLID_PAY_MERCHANT_NO=
SOLID_PAY_BASE_URL=https://soliapi.xyz
# On Vercel (no static IP) set SOLID_PAY_BASE_URL to the fixed-IP proxy, e.g.
# https://pay.pulsenow.xyz, and this to the secret the proxy checks.
# See infra/solidpay-proxy/README.md. Leave blank when calling SolidPay directly.
SOLID_PAY_PROXY_SECRET=
# Public origin SolidPay posts callbacks to (ngrok while testing). Blank falls
# back to the notify URLs saved in the SolidPay merchant backend.
APP_BASE_URL=
SOLID_PAY_CALLBACK_IPS=52.74.200.89
SOLID_PAY_ENFORCE_CALLBACK_IP=false

# ── Round monitor (app/x/[slug]) ──────────────────────────────────────────────
# Unlisted page mirroring live skyrise rounds. There is no password — the slug
# is the only secret, so anyone with the full URL can open it. Server-only —
# never prefix it with NEXT_PUBLIC_, that ships it in the browser bundle. Leave
# it blank and the route 404s, which is the safe default for any deployment that
# doesn't want the page. Generate it with:  openssl rand -hex 16
PEEK_SLUG=
